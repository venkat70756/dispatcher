/farms
{
    /vaikuntha
    {
        /clientheaders
        {
            "*"
        }

        /virtualhosts
        {
            "vaikuntha.local"
        }

        /renders
        {
            /render1
            {
                /hostname "localhost"
                /port "4503"
            }
        }

        /filter
        {
            /0001
            {
                /type "allow"
                /url "*"
            }

            /0002
            {
                /type "deny"
                /url "/content/we-retail/us/en/community/files.html"
             }
        }

        /cache
        {
            /docroot "/mnt/var/www/html"

            /statfile ".stat"

            /allowAuthorized "0"

            /serveStaleOnError "1"

            /rules
            {
                /0000
                {
                    /glob "*"
                    /type "allow"
                }
            }

            /invalidate
            {
                /0000
                {
                    /glob "*.html"
                    /type "allow"
                }
            }
        }
    }
}